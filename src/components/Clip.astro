---
import { videos, type VideoId } from '../data/videos';

/**
 * Demo video slot.
 *
 * The nine FORTIS clips are not yet published, so each slot renders a typed
 * placeholder describing what the clip shows. The placeholder is content in its
 * own right, not a "coming soon" message: it states what was demonstrated, which
 * is a fact traceable to the brief, and never implies footage is present.
 *
 * Once a file lands in public/video/, set `file` on the entry in
 * src/data/videos.ts and the same slot renders the real player with a poster
 * frame, preload="none" and no autoplay.
 */

interface Props {
  id: VideoId;
}

const { id } = Astro.props;
const clip = videos[id];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="clip">
  {
    clip.file ? (
      <figure>
        <video
          controls
          muted
          playsinline
          preload="none"
          poster={`${base}/video/${clip.poster}`}
          width="1000"
          height="562"
        >
          <source src={`${base}/video/${clip.file}`} type="video/mp4" />
          Your browser cannot play this clip.
        </video>
        <figcaption>
          {clip.caption}
          <span class="figcaption__source">Source: {clip.source}</span>
        </figcaption>
      </figure>
    ) : (
      <p class="clip__pending">
        <span class="label">Clip pending publication</span>
        <br />
        {clip.caption}
      </p>
    )
  }
</div>
