---
import { videos, type VideoId } from '../data/videos';

/**
 * Demo video slot, in order of preference:
 *
 *  1. A local file in public/video/ renders a native player with a poster.
 *  2. A YouTube id or playlist id renders the privacy-enhanced embed.
 *  3. A Drive file id renders Drive's preview player in a lazy iframe.
 *  4. Nothing: the caption renders as a typed description of the clip.
 */

interface Props {
  id: VideoId;
}

const { id } = Astro.props;
const clip = videos[id] as {
  file: string | null;
  poster: string | null;
  drive: string | null;
  youtube?: string | null;
  playlist?: string | null;
  caption: string;
  source: string;
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

let embed: string | null = null;
if (clip.youtube) {
  embed = `https://www.youtube-nocookie.com/embed/${clip.youtube}`;
  if (clip.playlist) embed += `?list=${clip.playlist}`;
} else if (clip.playlist) {
  embed = `https://www.youtube-nocookie.com/embed/videoseries?list=${clip.playlist}`;
} else if (clip.drive) {
  embed = `https://drive.google.com/file/d/${clip.drive}/preview`;
}
---

<div class="clip">
  {
    clip.file ? (
      <figure>
        <video
          controls
          muted
          playsinline
          preload="none"
          poster={clip.poster ? `${base}/video/${clip.poster}` : undefined}
          width="1000"
          height="562"
        >
          <source src={`${base}/video/${clip.file}`} type="video/mp4" />
          Your browser cannot play this clip.
        </video>
        <figcaption>
          {clip.caption}
          <span class="figcaption__source">Source: {clip.source}</span>
        </figcaption>
      </figure>
    ) : embed ? (
      <figure>
        <iframe
          src={embed}
          loading="lazy"
          allow="fullscreen; picture-in-picture"
          allowfullscreen
          title={clip.caption}
          width="1000"
          height="562"
        />
        <figcaption>
          {clip.caption}
          <span class="figcaption__source">Source: {clip.source}</span>
        </figcaption>
      </figure>
    ) : (
      <p class="clip__pending">{clip.caption}</p>
    )
  }
</div>
