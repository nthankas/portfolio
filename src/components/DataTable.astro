---
/**
 * The site's table primitive. Hairline rules, no zebra striping, units in the
 * header, numerics right-aligned with tabular figures.
 *
 * Columns declare their own alignment so numeric columns are right-aligned
 * without per-cell markup in the content files.
 */

export interface Column {
  /** Header text. Put the unit here rather than repeating it in every cell. */
  head: string;
  /** 'num' right-aligns the column and prevents wrapping. */
  align?: 'text' | 'num';
}

interface Props {
  caption: string;
  columns: Column[];
  rows: (string | number)[][];
  /** Row index and column index pairs to render in the accent color. */
  highlight?: [number, number][];
}

const { caption, columns, rows, highlight = [] } = Astro.props;

const isHighlighted = (r: number, c: number) =>
  highlight.some(([hr, hc]) => hr === r && hc === c);
---

<div class="table-wrap">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        {
          columns.map((col) => (
            <th scope="col" class={col.align === 'num' ? 'num' : undefined}>
              {col.head}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, r) => (
          <tr>
            {row.map((cell, c) => {
              const cls = [
                columns[c]?.align === 'num' ? 'num' : '',
                isHighlighted(r, c) ? 'hi' : '',
              ]
                .filter(Boolean)
                .join(' ');
              return c === 0 ? (
                <th scope="row" class={cls || undefined}>
                  {cell}
                </th>
              ) : (
                <td class={cls || undefined}>{cell}</td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
