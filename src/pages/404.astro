---
import Base from '../layouts/Base.astro';
import { owner } from '../site.config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title={`Not found · ${owner.name}`}
  description="This page does not exist."
  canonicalPath="/404"
>
  <div class="wrap" style="padding-top:24px">
    <div class="box" style="max-width:560px">
      <div class="box-title">404</div>
      <div class="box-body">
        <p>No such page. Whatever linked here is stale; everything on this site is reachable from the home page.</p>
        <ul class="plain">
          <li><span class="label">Home</span><a href={`${base}/`}>{owner.name}</a></li>
          <li><span class="label">Projects</span><a href={`${base}/#projects`}>All projects</a></li>
          <li><span class="label">Contact</span><a href={`mailto:${owner.email}`}>{owner.email}</a></li>
        </ul>
      </div>
    </div>
  </div>
</Base>
