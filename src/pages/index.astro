---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { experience, education } from '../data/experience';
import { repoIndex } from '../data/repos';
import { owner, siteMeta, resume } from '../site.config';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.priority - b.data.priority,
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const recent = experience.slice(0, 2);
const resumeHref = resume.file
  ? `${base}/${resume.file}`
  : `mailto:${owner.email}?subject=Resume%20request`;
---

<Base
  title={`${owner.name} · ${siteMeta.role}`}
  description={siteMeta.description}
  ogImage="/og/index.png"
  canonicalPath="/"
>
  <!-- intro band -->
  <section class="intro" aria-label="Introduction">
    <div class="wrap">
      <div class="info">
        <div class="info-box">
          <div class="box-title">Personal info</div>
          <dl class="kv">
            <dt>Currently</dt>
            <dd>Working in the Tactile Manipulation Lab under Tae Myung Huh</dd>
            <dt>Recently</dt>
            <dd>Robotics software intern at {recent.map((r) => r.org).join(' and ')}</dd>
            <dt>Location</dt>
            <dd>{owner.location}</dd>
            <dt>Focus</dt>
            <dd>Robotics software architecture, simulation, perception</dd>
          </dl>
        </div>
      </div>
      <div class="about">
        <p>
          hey, I'm Nikhil. I build the software layer of physical systems:
          architecture, simulation, perception and state estimation.
        </p>
        <p>
          Most of my work has been on robots that have to operate inside
          constraints someone else fixed, which is where the interesting
          engineering usually is.
        </p>
        <div class="btn-row">
          <a class="btn" href="#projects">projects</a>
          <a class="btn" href="#experience">experience</a>
          <a class="btn" href="#contact">contact</a>
          <a class="btn" href={resumeHref}>resume</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap cols">
    <!-- left column -->
    <aside class="side">
      {
        owner.photo && (
          <div class="photo">
            <img src={`${base}/${owner.photo}`} alt={`Photo of ${owner.name}`} width="640" height="640" decoding="async" />
          </div>
        )
      }
      <div class="namecard">
        <h1>{owner.name}</h1>
        <p class="role">{siteMeta.role}</p>
        <hr />
        <a class="btn btn-solid" href={`mailto:${owner.email}`}>+ Contact</a>
      </div>

      <div class="box">
        <div class="box-title">Recently worked on</div>
        <div class="box-body">
          <dl class="kv">
            {
              recent.map((r) => (
                <>
                  <dt>{r.org}</dt>
                  <dd>
                    {r.title}
                    <br />
                    <span class="muted">{r.dates}</span>
                  </dd>
                </>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="box">
        <div class="box-title">Education</div>
        <div class="box-body">
          <dl class="kv">
            {
              education.map((e) => (
                <>
                  <dt>{e.org}</dt>
                  <dd>
                    {e.degree}
                    <br />
                    {e.detail}
                    <br />
                    <span class="muted">{e.dates}</span>
                  </dd>
                </>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="box">
        <div class="box-title">Links</div>
        <div class="box-body">
          <ul class="plain">
            <li><a href={owner.githubUrl} rel="noopener">GitHub</a></li>
            <li><a href={owner.linkedinUrl} rel="noopener">LinkedIn</a></li>
            <li><a href={`mailto:${owner.email}`}>Email</a></li>
            <li><a href={resumeHref}>Resume</a></li>
          </ul>
        </div>
      </div>
    </aside>

    <!-- right column -->
    <div class="main">
      <section class="box" id="projects" aria-labelledby="projects-heading">
        <h2 class="box-title" id="projects-heading">Projects</h2>
        {projects.map((entry) => <ProjectEntry entry={entry} />)}
        <div class="box-body repos">
          <div class="table-wrap">
            <table>
              <caption>Other repositories at github.com/{owner.github}</caption>
              <thead>
                <tr>
                  <th scope="col">Repository</th>
                  <th scope="col">What it does</th>
                  <th scope="col">Language</th>
                </tr>
              </thead>
              <tbody>
                {
                  repoIndex.map((r) => (
                    <tr>
                      <td><a href={r.url} rel="noopener">{r.name}</a></td>
                      <td>{r.summary}</td>
                      <td>{r.language}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="box" id="experience" aria-labelledby="experience-heading">
        <h2 class="box-title" id="experience-heading">Experience</h2>
        {
          experience.map((role) => (
            <article class="job">
              <div class="head">
                <h3 class="org">{role.org}</h3>
                <span class="when">{role.dates}, {role.location}</span>
              </div>
              <p class="title">{role.title}</p>
              <p>{role.body}</p>
              <ul class="chips">
                {role.stack.map((s) => <li>{s}</li>)}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="box" id="contact" aria-labelledby="contact-heading">
        <h2 class="box-title" id="contact-heading">Contact</h2>
        <div class="box-body">
          <ul class="plain">
            <li><span class="label">Email</span><a href={`mailto:${owner.email}`}>{owner.email}</a></li>
            <li><span class="label">GitHub</span><a href={owner.githubUrl} rel="noopener">github.com/{owner.github}</a></li>
            <li><span class="label">LinkedIn</span><a href={owner.linkedinUrl} rel="noopener">linkedin.com/in/{owner.linkedin}</a></li>
            <li><span class="label">Resume</span><a href={resumeHref}>{resume.file ? `${resume.label} (PDF)` : 'By email'}</a></li>
          </ul>
        </div>
      </section>
    </div>
  </div>
</Base>
