---
import Base from './Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  /** Overrides the entry thesis for the standfirst, which runs to two sentences. */
  standfirst: string;
}

const { entry, standfirst } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Neighbouring case studies in priority order, for the footer navigation.
const studies = (await getCollection('projects', (p) => p.data.caseStudy))
  .sort((a, b) => a.data.priority - b.data.priority);
const i = studies.findIndex((p) => p.id === entry.id);
const prev = i > 0 ? studies[i - 1] : null;
const next = i >= 0 && i < studies.length - 1 ? studies[i + 1] : null;
---

<Base
  title={`${d.title} · Nikhil Thankasala`}
  description={d.description}
  ogImage={`/og/${entry.id}.png`}
>
  <article class="shell">
    <header class="case-head split">
      <div>
        <a class="backlink" href={`${base}/#projects`}>All projects</a>
        <h1>{d.title}</h1>
        <p class="lede">{standfirst}</p>
      </div>
      <dl class="meta">
        <div>
          <dt>Role</dt>
          <dd>{d.role}</dd>
        </div>
        <div>
          <dt>Context</dt>
          <dd>{d.org}</dd>
        </div>
        <div>
          <dt>Dates</dt>
          <dd>{d.dates}</dd>
        </div>
        {
          d.team && (
            <div>
              <dt>Team</dt>
              <dd>{d.team}</dd>
            </div>
          )
        }
        <div>
          <dt>Stack</dt>
          <dd>{d.stack.join(', ')}</dd>
        </div>
      </dl>
    </header>

    <div class="case-body">
      <slot />

      <h2>Artifacts</h2>
      <ul class="contact-list">
        {
          d.artifacts
            .filter((a) => a.href)
            .map((a) => (
              <li>
                <span class="label">{a.label}</span>
                <a href={a.href} rel="noopener">
                  {a.href.replace(/^https?:\/\//, '')}
                </a>
              </li>
            ))
        }
      </ul>

      <nav class="case-nav" aria-label="Other case studies">
        {
          prev ? (
            <a href={`${base}/work/${prev.data.caseStudy}`}>
              <span class="label">Previous</span>
              <span class="case-nav__title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={`${base}/work/${next.data.caseStudy}`} class="case-nav__next">
              <span class="label">Next</span>
              <span class="case-nav__title">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </article>
</Base>
