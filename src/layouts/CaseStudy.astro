---
import Base from './Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  /** Two-sentence opener shown under the title bar. */
  standfirst: string;
}

const { entry, standfirst } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = d.artifacts.filter((a) => a.href);

// Previous and next case study, in priority order.
const studies = (await getCollection('projects', (p) => p.data.caseStudy))
  .sort((a, b) => a.data.priority - b.data.priority);
const i = studies.findIndex((p) => p.id === entry.id);
const prev = i > 0 ? studies[i - 1] : null;
const next = i >= 0 && i < studies.length - 1 ? studies[i + 1] : null;
---

<Base
  title={`${d.title} · Nikhil Thankasala`}
  description={d.description}
  ogImage={`/og/${entry.id}.png`}
>
  <article class="wrap">
    <div class="case-bar">
      <h1>{d.title}</h1>
      <nav aria-label="Project links">
        {links.map((a) => <a href={a.href} rel="noopener">{a.label}</a>)}
        <a class="close" href={`${base}/#projects`} aria-label="Back to all projects" title="Back to all projects">&#x2715;</a>
      </nav>
    </div>

    <div class="case">
      <p class="lede">{standfirst}</p>

      <dl class="facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Context</dt><dd>{d.org}</dd></div>
        <div><dt>Dates</dt><dd>{d.dates}</dd></div>
        {d.team && <div><dt>Team</dt><dd>{d.team}</dd></div>}
        <div><dt>Stack</dt><dd>{d.stack.join(', ')}</dd></div>
      </dl>

      <slot />

      {
        links.length > 0 && (
          <>
            <h2>Links</h2>
            <ul class="plain">
              {links.map((a) => (
                <li>
                  <span class="label">{a.label}</span>
                  <a href={a.href} rel="noopener">{a.href!.replace(/^https?:\/\//, '')}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <nav class="case-nav" aria-label="Other case studies">
        {prev ? <a href={`${base}/work/${prev.data.caseStudy}`}>&lsaquo; {prev.data.title}</a> : <span />}
        <a href={`${base}/#projects`}>All projects</a>
        {next ? <a href={`${base}/work/${next.data.caseStudy}`}>{next.data.title} &rsaquo;</a> : <span />}
      </nav>
    </div>
  </article>
</Base>
