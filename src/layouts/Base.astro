---
import '../styles/global.css';
import { owner, siteMeta, deploy, resume } from '../site.config';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
}

const { title, description, ogImage, canonicalPath } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? deploy.site);
const ogUrl = ogImage ? new URL(withBase(ogImage), Astro.site ?? deploy.site) : undefined;

// On case study pages the section anchors live on the home page.
const isHome = Astro.url.pathname.replace(/\/$/, '') === base.replace(/\/$/, '');
const home = withBase('/');
const nav = [
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
].map((n) => ({ ...n, href: isHome ? n.href : `${home}${n.href}` }));

const resumeHref = resume.file
  ? withBase(`/${resume.file}`)
  : `mailto:${owner.email}?subject=Resume%20request`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={owner.name} />
    {ogUrl && <meta property="og:image" content={ogUrl.href} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />

    <meta name="author" content={owner.name} />
    <meta name="theme-color" content="#1f3b63" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: owner.name,
        email: `mailto:${owner.email}`,
        url: canonical.origin + base,
        jobTitle: siteMeta.role,
        sameAs: [owner.githubUrl, owner.linkedinUrl],
        alumniOf: {
          '@type': 'CollegeOrUniversity',
          name: 'University of California, Santa Cruz',
        },
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="bar">
      <div class="wrap">
        <a class="name" href={home}>nikhil thankasala</a>
        <nav aria-label="Sections">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href={resumeHref}>Resume</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <span>{owner.name}, {siteMeta.role.toLowerCase()}</span>
        <span>{owner.location}</span>
      </div>
    </footer>
  </body>
</html>
